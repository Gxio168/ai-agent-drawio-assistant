<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.bugstack.ai.infrastructure.dao.AgentChatSessionEventMapper">

    <resultMap id="agentChatSessionEventResult" type="cn.bugstack.ai.infrastructure.dao.po.AgentChatSessionEventPO">
        <id column="id" property="id"/>
        <result column="session_pk" property="sessionPk"/>
        <result column="event_id" property="eventId"/>
        <result column="invocation_id" property="invocationId"/>
        <result column="author" property="author"/>
        <result column="event_timestamp" property="eventTimestamp"/>
        <result column="event_data" property="eventData"/>
    </resultMap>

    <insert id="insert" parameterType="cn.bugstack.ai.infrastructure.dao.po.AgentChatSessionEventPO">
        INSERT INTO ai_agent_chat_session_event
            (session_pk, event_id, invocation_id, author, event_timestamp, event_data)
        VALUES
            (#{sessionPk}, #{eventId}, #{invocationId}, #{author}, #{eventTimestamp}, #{eventData})
    </insert>

    <select id="findBySession" resultMap="agentChatSessionEventResult">
        SELECT id, session_pk, event_id, invocation_id, author, event_timestamp, event_data
        FROM ai_agent_chat_session_event
        WHERE session_pk = #{sessionPk}
        ORDER BY id ASC
    </select>

    <delete id="deleteBySession">
        DELETE FROM ai_agent_chat_session_event
        WHERE session_pk = #{sessionPk}
    </delete>

</mapper>
